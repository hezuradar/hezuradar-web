rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['orderCode','status','items','subtotal','customer','shipping'])
        && request.resource.data.orderCode is string && request.resource.data.orderCode.size() < 40
        && request.resource.data.status is string
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 50
        && request.resource.data.subtotal is number && request.resource.data.subtotal >= 0 && request.resource.data.subtotal < 100000
        && request.resource.data.customer.name is string && request.resource.data.customer.name.size() < 200
        && request.resource.data.customer.phone is string && request.resource.data.customer.phone.size() < 40
        && request.resource.data.shipping.address is string && request.resource.data.shipping.address.size() < 300
        && (!('notes' in request.resource.data.shipping) || request.resource.data.shipping.notes.size() < 1000);
      allow read, update, delete: if request.auth != null;
    }
    match /analytics_daily/{date} {
      allow read: if request.auth != null;
      allow create, update: if date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys()
             .hasOnly(['visits', 'pages', 'productViews', 'productTitles', 'updatedAt']);
      allow delete: if request.auth != null;
    }
  }
}
