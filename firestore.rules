rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cuentas que pueden ver y gestionar pedidos y estadísticas desde admin.html.
    // Si entras al panel con otro correo, añádelo aquí antes de publicar las reglas.
    // Se reconoce por el UID de la cuenta (que nadie puede suplantar) o por el correo solo si
    // está verificado: con el correo a secas, quien pudiera registrar una de esas direcciones
    // (si algún día se reabre el alta de usuarios) entraría como administrador.
    function isAdmin() {
      return request.auth != null
        && (request.auth.uid in ['r6e866zfOcVwU1U62F6bXPa76XB3']
            || (request.auth.token.email in ['hezuradar@gmail.com', 'iotegi@gmail.com']
                && request.auth.token.email_verified == true));
    }

    function isStr(v, max) {
      return v is string && v.size() <= max;
    }

    function optStr(m, key, max) {
      return !(key in m) || isStr(m[key], max);
    }

    function optNum(m, key, max) {
      return !(key in m) || (m[key] is number && m[key] >= 0 && m[key] <= max);
    }

    // Línea de pedido de la cesta (cart.js) o de los diseñadores (disenador.js). Las reglas
    // no pueden recorrer listas, así que se comprueban la primera y la última línea.
    function validItem(it) {
      return it is map
        && it.keys().hasOnly(['id', 'title', 'price', 'originalPrice', 'discountPercent', 'qty', 'image'])
        && isStr(it.id, 120) && isStr(it.title, 200)
        && it.qty is int && it.qty >= 1 && it.qty <= 5000
        && it.price is number && it.price >= 0 && it.price <= 10000
        && optNum(it, 'originalPrice', 10000) && optNum(it, 'discountPercent', 100)
        && optStr(it, 'image', 300);
    }

    // Pedido creado desde la cesta (cart.js) o desde los diseñadores (disenador.js).
    function validPublicOrder() {
      let d = request.resource.data;
      return d.keys().hasOnly(['orderCode', 'createdAt', 'createdAtServer', 'status', 'items', 'subtotal',
                               'shippingCost', 'total', 'paymentMethod', 'customer', 'shipping',
                               'kind', 'material', 'design', 'lang'])
        && d.keys().hasAll(['orderCode', 'createdAtServer', 'status', 'items', 'subtotal', 'customer', 'shipping'])
        // A partir de aquí las comprobaciones van escritas a mano en vez de con isStr/optStr:
        // Firestore limita las llamadas a funciones por petición y, al añadir country y method
        // con optStr (envíos internacionales), los pedidos de 3 líneas o más pasaban del límite
        // y se rechazaban todos (comprobado el 02/11/2026 con la API de pruebas de reglas).
        && d.orderCode is string && d.orderCode.size() <= 40
        && d.status == 'pendiente'
        // Siempre lo pone firebase-orders.js; el Apps Script lo usa para la ventana de
        // confirmación por email, así que no puede faltar ni falsearse con createdAt.
        && d.createdAtServer == request.time
        && (!('createdAt' in d) || (d.createdAt is string && d.createdAt.size() <= 40))
        && d.items is list && d.items.size() > 0 && d.items.size() <= 50
        && validItem(d.items[0]) && validItem(d.items[d.items.size() - 1])
        // No añadir más llamadas a validItem: Firestore corta la evaluación cuando pasa de un
        // tope de expresiones por petición y rechaza el pedido. El 22/10/2026 una cuarta
        // llamada (items[2]) tumbó los pedidos de 4+ líneas, y el 02/11/2026 la de items[1]
        // tumbó los de 3+ líneas (comprobado con la API de pruebas de reglas).
        && d.subtotal is number && d.subtotal >= 0 && d.subtotal < 100000
        && (!('shippingCost' in d) || (d.shippingCost is number && d.shippingCost >= 0 && d.shippingCost < 100))
        && (!('total' in d) || (d.total is number && d.total >= 0 && d.total < 100000))
        && (!('paymentMethod' in d) || d.paymentMethod in ['', 'paypal', 'bizum', 'otros'])
        && (!('kind' in d) || d.kind in ['placa-personalizada', 'pua-personalizada'])
        // Idioma en que compró el cliente (assets/js/i18n.js): el de su email de confirmación.
        && (!('lang' in d) || d.lang in ['es', 'en'])
        && d.customer is map
        && d.customer.keys().hasOnly(['name', 'phone', 'email'])
        && d.customer.name is string && d.customer.name.size() <= 200
        && d.customer.phone is string && d.customer.phone.size() <= 40
        && (!('email' in d.customer) || (d.customer.email is string && d.customer.email.size() <= 200))
        && d.shipping is map
        && d.shipping.keys().hasOnly(['address', 'postalCode', 'city', 'province', 'country', 'method', 'notes'])
        && d.shipping.address is string && d.shipping.address.size() <= 300
        && (!('postalCode' in d.shipping) || (d.shipping.postalCode is string && d.shipping.postalCode.size() <= 20))
        && (!('city' in d.shipping) || (d.shipping.city is string && d.shipping.city.size() <= 120))
        && (!('province' in d.shipping) || (d.shipping.province is string && d.shipping.province.size() <= 120))
        && (!('notes' in d.shipping) || (d.shipping.notes is string && d.shipping.notes.size() <= 1000))
        && (!('country' in d.shipping) || (d.shipping.country is string && d.shipping.country.size() <= 80))
        && (!('method' in d.shipping) || (d.shipping.method is string && d.shipping.method.size() <= 60))
        && (!('material' in d) || (d.material is map && d.material.keys().hasOnly(['id', 'label'])
              && d.material.id is string && d.material.id.size() <= 60
              && d.material.label is string && d.material.label.size() <= 120))
        && (!('design' in d) || (d.design is map
              && d.design.keys().hasOnly(['snapshot', 'fileName', 'fileType', 'fileData', 'fileTooLargeToEmbed'])
              && (!('snapshot' in d.design) || (d.design.snapshot is string && d.design.snapshot.size() <= 1000000))
              && (!('fileName' in d.design) || (d.design.fileName is string && d.design.fileName.size() <= 200))
              && (!('fileType' in d.design) || (d.design.fileType is string && d.design.fileType.size() <= 100))
              && (!('fileData' in d.design) || d.design.fileData == null || d.design.fileData is string)
              && (!('fileTooLargeToEmbed' in d.design) || d.design.fileTooLargeToEmbed is bool)));
    }

    match /orders/{orderId} {
      allow create: if isAdmin() || validPublicOrder();
      allow read, update, delete: if isAdmin();
    }

    // Token de GitHub del panel de administración (admin.js): se guarda aquí para poder
    // entrar desde cualquier móvil con el login, sin repetir la configuración en cada navegador.
    match /adminConfig/github {
      allow get, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['token', 'updatedAt', 'updatedBy'])
        && isStr(request.resource.data.token, 255);
    }

    // Contadores de analytics.js. Los escribe cualquier visitante, así que cada escritura
    // solo puede sumar 1 a las visitas y tocar una clave de cada mapa, sin borrar nada:
    // nadie puede poner a cero ni inflar de golpe las estadísticas.
    function counterMapOk(d, old, key, maxSize) {
      return !(key in d) || (d[key] is map
        && d[key].size() <= maxSize
        && d[key].diff(old.get(key, {})).removedKeys().size() == 0
        && d[key].diff(old.get(key, {})).affectedKeys().size() <= 1);
    }

    function validAnalyticsWrite() {
      let d = request.resource.data;
      let old = resource == null ? {} : resource.data;
      let diff = d.diff(old);
      return diff.affectedKeys().hasOnly(['visits', 'pages', 'productViews', 'productTitles', 'updatedAt'])
        && diff.removedKeys().size() == 0
        && (!('visits' in diff.affectedKeys()) || (d.visits is int && d.visits == old.get('visits', 0) + 1))
        && counterMapOk(d, old, 'pages', 30)
        && counterMapOk(d, old, 'productViews', 1000)
        && counterMapOk(d, old, 'productTitles', 1000)
        && (!('updatedAt' in diff.affectedKeys()) || d.updatedAt == request.time);
    }

    // El documento del día lo nombra el navegador con su fecha local: se admite el día de
    // hoy en UTC y los adyacentes (husos horarios), no cualquier fecha inventada.
    function dayKey(t) {
      return string(t.year()) + '-' + (t.month() < 10 ? '0' : '') + string(t.month())
        + '-' + (t.day() < 10 ? '0' : '') + string(t.day());
    }

    function isNearToday(date) {
      return date in [dayKey(request.time - duration.value(1, 'd')), dayKey(request.time),
                      dayKey(request.time + duration.value(1, 'd'))];
    }

    match /analytics_daily/{date} {
      allow read, delete: if isAdmin();
      allow create, update: if date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && isNearToday(date) && validAnalyticsWrite();
    }
  }
}
