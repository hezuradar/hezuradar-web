rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cuentas que pueden ver y gestionar pedidos y estadísticas desde admin.html.
    // Si entras al panel con otro correo, añádelo aquí antes de publicar las reglas.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['hezuradar@gmail.com', 'iotegi@gmail.com'];
    }

    function isStr(v, max) {
      return v is string && v.size() <= max;
    }

    function optStr(m, key, max) {
      return !(key in m) || isStr(m[key], max);
    }

    // Pedido creado desde la cesta (cart.js) o desde los diseñadores (disenador.js).
    function validPublicOrder() {
      let d = request.resource.data;
      return d.keys().hasOnly(['orderCode', 'createdAt', 'createdAtServer', 'status', 'items', 'subtotal',
                               'shippingCost', 'total', 'paymentMethod', 'customer', 'shipping',
                               'kind', 'material', 'design'])
        && d.keys().hasAll(['orderCode', 'createdAtServer', 'status', 'items', 'subtotal', 'customer', 'shipping'])
        && isStr(d.orderCode, 40)
        && d.status == 'pendiente'
        // Siempre lo pone firebase-orders.js; el Apps Script lo usa para la ventana de
        // confirmación por email, así que no puede faltar ni falsearse con createdAt.
        && d.createdAtServer == request.time
        && optStr(d, 'createdAt', 40)
        && d.items is list && d.items.size() > 0 && d.items.size() <= 50
        && d.subtotal is number && d.subtotal >= 0 && d.subtotal < 100000
        && (!('shippingCost' in d) || (d.shippingCost is number && d.shippingCost >= 0 && d.shippingCost < 100))
        && (!('total' in d) || (d.total is number && d.total >= 0 && d.total < 100000))
        && (!('paymentMethod' in d) || d.paymentMethod in ['', 'paypal', 'bizum', 'otros'])
        && (!('kind' in d) || d.kind in ['placa-personalizada', 'pua-personalizada'])
        && d.customer is map
        && d.customer.keys().hasOnly(['name', 'phone', 'email'])
        && isStr(d.customer.name, 200) && isStr(d.customer.phone, 40) && optStr(d.customer, 'email', 200)
        && d.shipping is map
        && d.shipping.keys().hasOnly(['address', 'postalCode', 'city', 'province', 'notes'])
        && isStr(d.shipping.address, 300)
        && optStr(d.shipping, 'postalCode', 20) && optStr(d.shipping, 'city', 120)
        && optStr(d.shipping, 'province', 120) && optStr(d.shipping, 'notes', 1000)
        && (!('material' in d) || (d.material is map && d.material.keys().hasOnly(['id', 'label'])
              && isStr(d.material.id, 60) && isStr(d.material.label, 120)))
        && (!('design' in d) || (d.design is map
              && d.design.keys().hasOnly(['snapshot', 'fileName', 'fileType', 'fileData', 'fileTooLargeToEmbed'])
              && optStr(d.design, 'snapshot', 1000000)
              && optStr(d.design, 'fileName', 200)
              && optStr(d.design, 'fileType', 100)
              && (!('fileData' in d.design) || d.design.fileData == null || d.design.fileData is string)
              && (!('fileTooLargeToEmbed' in d.design) || d.design.fileTooLargeToEmbed is bool)));
    }

    match /orders/{orderId} {
      allow create: if isAdmin() || validPublicOrder();
      allow read, update, delete: if isAdmin();
    }

    // Contadores de analytics.js. Los escribe cualquier visitante, así que cada escritura
    // solo puede sumar 1 a las visitas y tocar una clave de cada mapa, sin borrar nada:
    // nadie puede poner a cero ni inflar de golpe las estadísticas.
    function counterMapOk(d, old, key, maxSize) {
      return !(key in d) || (d[key] is map
        && d[key].size() <= maxSize
        && d[key].diff(old.get(key, {})).removedKeys().size() == 0
        && d[key].diff(old.get(key, {})).affectedKeys().size() <= 1);
    }

    function validAnalyticsWrite() {
      let d = request.resource.data;
      let old = resource == null ? {} : resource.data;
      let diff = d.diff(old);
      return diff.affectedKeys().hasOnly(['visits', 'pages', 'productViews', 'productTitles', 'updatedAt'])
        && diff.removedKeys().size() == 0
        && (!('visits' in diff.affectedKeys()) || (d.visits is int && d.visits == old.get('visits', 0) + 1))
        && counterMapOk(d, old, 'pages', 30)
        && counterMapOk(d, old, 'productViews', 1000)
        && counterMapOk(d, old, 'productTitles', 1000)
        && (!('updatedAt' in diff.affectedKeys()) || d.updatedAt == request.time);
    }

    match /analytics_daily/{date} {
      allow read, delete: if isAdmin();
      allow create, update: if date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && validAnalyticsWrite();
    }
  }
}
